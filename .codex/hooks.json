{
  "description": "Protect shared branches during agent work.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__GitKraken__git_push|mcp__codex_apps__github_merge_pull_request|mcp__codex_apps__github_enable_auto_merge",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/git_guard.py\"",
            "statusMessage": "Checking shared branch protections"
          }
        ]
      }
    ]
  }
}
